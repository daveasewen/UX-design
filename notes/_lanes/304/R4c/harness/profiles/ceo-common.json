{
  "id": "ceo-common",
  "prompt": "notes/_lanes/303/DEMO-PROMPT-2026-09-25-hsbc-ceo-common.md",
  "$note": "What the CEO Common prompt asks for, as data the harness checks against. Every field quotes or paraphrases the prompt; nothing here is a ruling.",
  "theme": {"attr": "common", "aliases": ["legacy"], "modes": ["light", "dark"], "switch_required": true,
            "tokens_light": {"--button-primary-background-default": "#DB0011", "--border-radius-default": "0"}},
  "views": ["overview", "accounts", "liquidity", "payments", "fx", "risk", "trade finance", "reports", "messages", "settings"],
  "view_patterns": {
    "overview": "overview|home|dashboard",
    "accounts": "account|transaction",
    "liquidity": "liquidity|funding",
    "payments": "payment|approval",
    "fx": "\\bfx\\b|market|foreign exchange",
    "risk": "risk|limit",
    "trade finance": "trade",
    "reports": "report",
    "messages": "message|service request|inbox",
    "settings": "setting|preference"
  },
  "kpis": {"cash": "\\bcash\\b", "liquidity": "liquidity", "headroom": "headroom"},
  "questions": {"resilience": "resilien|fund our plans|can we fund", "exposure": "exposure", "decisions": "approval|exception|attention"},
  "charts": {"liberal": true, "min_charts_overview": 4, "want_all_types": true,
             "pack_types": ["bar","boxplot","bullet","butterfly-h","butterfly-v","candlestick","combo","donut","histogram","line","pie","scatter","sparkline","stacked-area"]},
  "records": {"min_rows": 25},
  "series_days": 30,
  "families_wanted": ["nav","filter","search","sort","paging","detail","approve","export","theme","message","ack","tabs"]
}
