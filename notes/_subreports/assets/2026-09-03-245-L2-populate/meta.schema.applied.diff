+            "string",
+            "null"
+          ],
+          "pattern": "^knowledge/(?:[^#\\s]+\\.js|snippets/[^#\\s/]+\\.reference\\.html#script)$"
+        },
+        "partial": {
+          "type": [
+            "string",
+            "array",
+            "null"
+          ],
+          "pattern": "^[a-z][a-z0-9-]*$",
+          "items": {
