# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Local env / secrets
.env
*.local

# Client-asset hygiene (ADR-0005): raw Figma exports stay untracked
knowledge/tokens/_raw/

# Generated designer KB (rebuild with designer-skills-v1/build-designer-kb.sh)
designer-skills-v1/knowledge/

# Local delete-staging (bridge cannot rm)
_to_delete/

# MS Office lock/temp files
~$*

# Distributable build artifacts
*.zip

# Licensed font binaries (desktop + webfont packs) — internal use, not for distribution/repo
knowledge/assets/fonts/

# Font-embedded review sheets (added 2026-07-18) — these inline the licensed Latin face as
# base64 woff2 so specimens render in real Univers. That is the whole point of them, but it
# also means the file CONTAINS the font binary, which the rule above exists to keep out of
# the repo. Ignoring the built HTML rather than dropping the technique: the GENERATORS are
# committed and reproduce these locally in seconds from the (gitignored) font files.
# If a font-embedded sheet ever needs sharing outside, export a PDF — do not commit the HTML.
reviews/*CONTACT*.html

# scratch render output (sandbox cannot unlink; see _RUNBOOK-git-commit.md)
outputs/
__tmp_moved.html

# Secrets — never commit (born #53)
.env.local
API-KEY.txt
