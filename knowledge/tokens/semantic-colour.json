    "default": {
      "light": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "dark": {
        "$value": "#000000",
        "$type": "color"
      },
      "$alias": {
        "light": "color/white",
        "dark": "color/grey/black"
      }
    }
  },
  "focus": {
    "$description": "Keyboard focus-indicator ring. INFERRED standard — the HSBC Common Toolkit Figma library carries NO canonical focus primitive (searched 2026-06-19: no focus/outline/ring variable exists; focus is handled in the React/CSS layer, not as a token). Grounded in the system's existing information-blue ramp rather than an invented hex, and tagged review pending design-team confirmation. Ring width/offset live in layout.json (focus block). Standard: guidelines/focus-indicators.md. Contrast verified ≥3:1 (1.4.11): light 7.17:1 on #FFFFFF, dark 4.24:1 on #1D1D1D.",
    "ring": {
      "light": {
        "$value": "#305A85",
        "$type": "color"
      },
      "dark": {
        "$value": "#4587A7",
        "$type": "color"
      },
      "$alias": {
        "light": "color/blue/600",
        "dark": "color/blue/400"
      },
      "$confidence": "review"
    }
  },
